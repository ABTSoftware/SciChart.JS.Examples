{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SciChart Tauri Licensing",
  "version": "0.1.0",
  "identifier": "com.example.scichart-tauri-licensing",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SciChart Simple Server Licensing (Tauri)",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/128x128.png"]
  }
}
