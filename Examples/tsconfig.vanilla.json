{
    "compilerOptions": {
        "noEmit": false,
        "sourceMap": false,
        "strict": false,
        "noImplicitAny": false,
        "alwaysStrict": false,
        "target": "ESNext",
        "allowJs": false,
        "checkJs": false,
        "tsBuildInfoFile": "./.cache/vanilla.tsbuildinfo"
    },
    "include": ["src/**/vanilla.ts", "src/**/drawExample.ts", "src/**/*.d.ts"],
    "exclude": ["node_modules", "src/static/*"],
    "extends": "./tsconfig.base.json"
}
