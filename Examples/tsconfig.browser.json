{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "react", "react-dom", "react-syntax-highlighter"],
        "incremental": true,
        "tsBuildInfoFile": "./.cache/browser.tsbuildinfo"
    },
    "include": [
        "src/components/**/*",
        "src/helpers/**/*",
        "src/hooks/**/*",
        "src/utils/**/*",
        "src/types/**/*",
        "src/index.tsx",
        "src/constants.ts"
    ],
    "exclude": [
        "node_modules",
        "src/static/*",
        "src/**/vanilla.ts",
        "src/**/angular.ts",
        "src/scichart-react/**",
        "src/server/**/*"
    ]
}
